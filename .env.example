# Required
GEMINI_API_KEY=

# Optional / defaults
# tiny = 8GB-friendly default; use base for non-English / localization jobs
WHISPER_MODEL=tiny
USE_NESTED_GRAPH=false
PATH_ONLY_STATE=true
FFMPEG_POOL_WORKERS=2
THUMBNAIL_MAX_VARIANTS=3
OBJECT_DETECTION=true
TREND_CACHE_TTL_HOURS=24
FFMPEG_PATH=
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
APP_ENV=development
LOG_TO_FILE=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
MAX_UPLOAD_MB=500
YOUTUBE_API_KEY=
# YouTube media download via yt-dlp (authorized content only). Set false for metadata-only.
YOUTUBE_DOWNLOAD_ENABLED=true
YOUTUBE_DOWNLOAD_FORMAT=bestvideo*+bestaudio/best
YOUTUBE_COOKIES_FILE=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=2
GEMINI_RETRY_MAX_SECONDS=30
TTS_PROVIDER=edge
ANALYSIS_SAMPLE_FPS=1.0
ANALYSIS_SCENE_THRESHOLD=0.35
ANALYSIS_MAX_FRAMES=900
SCENE_MIN_DURATION=1.5
SCENE_MIN_GAP=0.4
SCENE_MAX_SCENES=120
SCENE_SPEAKER_GAP=1.25
AUDIO_PAUSE_GAP=0.6
AUDIO_VOLUME_SPIKE_DB=6.0
AUDIO_MAX_EVENTS=200
SPEAKER_TURN_GAP=0.8
MOMENT_MIN_SCORE=0.35
MOMENT_MAX_PER_CATEGORY=40
MOMENT_MIN_DURATION=1.0
MOMENT_MERGE_GAP=0.75
FUNNY_MIN_HUMOR_SCORE=0.4
FUNNY_MAX_MOMENTS=50
FUNNY_SETUP_WINDOW=4.0
FUNNY_LAUGHTER_WEIGHT=0.25
VIRAL_MIN_FINAL_SCORE=0.4
VIRAL_MAX_MOMENTS=40
VIRAL_WINDOW_PAD=1.5
CLIP_TARGET_DURATION=30
CLIP_DURATION_TOLERANCE=0.35
CLIP_MAX_CLIPS=20
CLIP_MAX_OVERLAP=0.35
CLIP_MIN_SCORE=0.35
PODCAST_MAX_CLIPS=25
PODCAST_MIN_SCORE=0.35
PODCAST_TARGET_DURATION=45
RESEARCH_MAX_CLAIMS=40
RESEARCH_MAX_SOURCES=60
RESEARCH_MIN_CONFIDENCE=0.35
SUPERVISOR_MAX_STEPS=16
SUPERVISOR_MAX_RETRIES=1
CALENDAR_HORIZON_DAYS=30
CALENDAR_POSTS_PER_WEEK=7
